# Copy this file to .env (which git ignores) and fill in your key.
# Never put a real key in THIS file: .env.example is committed to git.

# Which LLM to use: gemini | ollama | demo-safe   (demo-safe = no LLM at all)
LLM_PROVIDER=gemini

# Gemini (free tier key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING=low

# Ollama (optional local fallback, https://ollama.com)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
